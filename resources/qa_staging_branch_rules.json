{
  "name": "QA Staging Branch Rules",
  "target": "branch",
  "source_type": "Repository",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "refs/heads/staging"
      ]
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_linear_history"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "required_reviewers": [],
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false,
        "allowed_merge_methods": [
          "merge",
          "squash",
          "rebase"
        ]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "discover / discover-workflows"
          },
          {
            "context": "recompile-workflows / recompile-workflows"
          },
          {
            "context": "test-workflows (macos-latest)"
          },
          {
            "context": "test-workflows (ubuntu-latest)"
          },
          {
            "context": "test-workflows (windows-latest)"
          },
          {
            "context": "validate-spec"
          }
        ]
      }
    }
  ],
  "bypass_actors": []
}
